# ===================== BharathVoice AI — Environment Configuration =====================
# Copy this file to backend/.env (or export these vars) before running the backend.
# Never commit real secrets to source control.

# ---- Database ----
# Default (zero-config local demo): SQLite file.
# For production, point to PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://bharathvoice:password@localhost:5432/bharathvoice
DATABASE_URL=sqlite:///./bharathvoice.db

# ---- CORS ----
CORS_ORIGINS=*

# ---- Knowledge base / vector index ----
KNOWLEDGE_BASE_DIR=../knowledge_base
FAISS_INDEX_DIR=./faiss_index
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- LLM provider (choose ONE; leave both blank to run in grounded-template mode) ----
# Option A: Hugging Face Inference API
LLM_PROVIDER=huggingface
HUGGINGFACE_API_TOKEN=
HF_LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Option B: OpenAI-compatible endpoint
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---- Optional server-side voice (browser Web Speech API is used by default) ----
STT_MODEL=openai/whisper-large-v3

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=403671615206-4lotouho6netfaf8d84h4vi5ko37tnsn.apps.googleusercontent.com

